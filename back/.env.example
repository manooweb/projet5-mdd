# Copy this file to .env and choose local development passwords.
MYSQL_DATABASE=mdd_db
MYSQL_USER=mdd_db_user
MYSQL_PASSWORD=replace-with-a-strong-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-local-root-password
MDD_JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
MDD_JWT_SECURE_COOKIE=false
