{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "cypress:open": "ELECTRON_RUN_AS_NODE= cypress open --expose coverage=false",
    "cypress:run": "ELECTRON_RUN_AS_NODE= cypress run --expose coverage=false",
    "cypress:run:coverage": "ELECTRON_RUN_AS_NODE= cypress run --config baseUrl=http://127.0.0.1:4201",
    "e2e": "start-server-and-test start http://127.0.0.1:4200 cypress:run",
    "build:e2e:coverage": "ng run front:build-e2e-coverage",
    "start:e2e:coverage": "npm run build:e2e:coverage && http-server dist/front-e2e-coverage/browser -a 127.0.0.1 -p 4201 -c-1 -s",
    "e2e:coverage": "start-server-and-test start:e2e:coverage http://127.0.0.1:4201 cypress:run:coverage"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.1.0"
  },
  "nyc": {
    "report-dir": "../coverage/front-e2e",
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ],
    "exclude": [
      "src/main.ts"
    ],
    "excludeAfterRemap": true
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^22.0.1",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.1.0",
    "cypress": "^15.20.0",
    "eslint": "^10.8.1",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^28.0.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.8"
  }
}
