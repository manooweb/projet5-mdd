meta {
  name: Create Post
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/posts
  body: json
  auth: none
}

body:json {
  {
    "topicId": {{topicId}},
    "title": "{{postTitle}}",
    "content": "{{postContent}}"
  }
}

tests {
