meta {
  name: Update Current User
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/users/me
  body: json
  auth: none
}

body:json {
  {
    "username": "{{updateUsername}}",
    "email": "{{updateEmail}}",
    "password": "{{updatePassword}}"
  }
}

tests {
  test("status is 204", function () {
    expect(res.status).to.equal(204);
  });
}
