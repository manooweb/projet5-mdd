meta {
  name: Current User
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/users/me
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the authenticated user's public profile", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.username).to.equal("bruno-user");
    expect(res.body.email).to.equal("bruno-user@example.test");
    expect(res.body).not.to.have.property("password");
  });
}
