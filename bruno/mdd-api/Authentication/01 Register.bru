meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "bruno-user",
    "email": "bruno-user@example.test",
    "password": "Pass1!wd"
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("authentication cookie is returned", function () {
    const setCookies = res.headers["set-cookie"] || [];
    const found = setCookies.some((cookie) =>
      cookie.includes("MDD_AUTH_TOKEN=") &&
      cookie.includes("HttpOnly") &&
      cookie.includes("SameSite=Lax")
    );
    expect(found).to.equal(true);
  });
}

docs {
  The collection pre-request script initializes the CSRF cookie and header automatically.
}
